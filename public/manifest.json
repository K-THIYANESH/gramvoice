{
  "$schema": "https://json.schemastore.org/web-manifest-combined.json",
  "id": "/?source=pwa",
  "name": "GramVoice TN — தமிழ்நாடு ஊரக உள்ளாட்சி தளம்",
  "short_name": "GramVoice TN",
  "description": "Voice-First Tamil Nadu Rural Governance, Gram Sabha & SLA Grievance Platform",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "background_color": "#064e3b",
  "theme_color": "#065f46",
  "lang": "ta-IN",
  "dir": "ltr",
  "categories": ["government", "utilities", "productivity", "social"],
  "icons": [
    {
      "src": "/pwa-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/pwa-icon-maskable.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "maskable"
    },
    {
      "src": "/icon-192.svg",
      "sizes": "192x192",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icon-512.svg",
      "sizes": "512x512",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Report Problem (குறைதீர்ப்பு)",
      "short_name": "Report Problem",
      "description": "File a public grievance with voice and GPS",
      "url": "/?tab=citizen&view=report_problem",
      "icons": [{ "src": "/pwa-icon.svg", "sizes": "any" }]
    },
    {
      "name": "Gram Sabha Agenda (கிராம சபை)",
      "short_name": "Gram Sabha",
      "description": "Participate in upcoming Gram Sabha votes",
      "url": "/?tab=citizen&view=gramsabha",
      "icons": [{ "src": "/pwa-icon.svg", "sizes": "any" }]
    },
    {
      "name": "Panchayat Projects (ஊர் திட்டங்கள்)",
      "short_name": "Projects",
      "description": "Explore village works and DPR budgets",
      "url": "/?tab=citizen&view=projects",
      "icons": [{ "src": "/pwa-icon.svg", "sizes": "any" }]
    },
    {
      "name": "Open Transparency Portal",
      "short_name": "Public Portal",
      "description": "View open datasets and financial ledgers",
      "url": "/?tab=public",
      "icons": [{ "src": "/pwa-icon.svg", "sizes": "any" }]
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false
}
